# Required for real Sentinel-2 L2A processing. Without these values, the app
# reports provider_unconfigured and does not fabricate maps or indicators.
SENTINELHUB_CLIENT_ID=98aed7aa-45e6-4cb0-ae9e-350a1e5fc8ec
SENTINELHUB_CLIENT_SECRET=SnHmHBfk0g5TdodLcYt4uGhmcjtzmWAe

# Optional endpoint overrides. Defaults use Sentinel Hub EU-Central deployment.
SENTINELHUB_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
SENTINELHUB_PROCESS_URL=https://services.sentinel-hub.com/api/v1/process
SENTINELHUB_STATISTICS_URL=https://services.sentinel-hub.com/api/v1/statistics

# Optional Google Earth Engine service account hook for a future adapter.
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=
GOOGLE_EARTH_ENGINE_PRIVATE_KEY=
